{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAHM Visual Editor Session",
  "type": "object",
  "required": ["schemaVersion","id","createdAt","manifest","before","after","operations","componentMap","assets","screenshots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^SAHM-EDIT-" },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["local-draft","synced","reviewed","applied","conflicted"] },
    "manifest": { "type": "object", "required": ["application","branch","baseBranch","baseCommit","screen","sourceFile"] },
    "before": { "type": "object" },
    "after": { "type": "object" },
    "operations": { "type": "array", "items": { "type": "object", "required": ["type","elementId","screen","timestamp"] } },
    "componentMap": { "type": "object" },
    "assets": { "type": "array" },
    "screenshots": { "type": "object", "properties": { "before": {}, "after": {} } }
  },
  "additionalProperties": true
}