{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAHM Adaptive Layout Data",
  "oneOf": [
    {
      "$ref": "#/$defs/profile"
    },
    {
      "$ref": "#/$defs/component"
    },
    {
      "$ref": "#/$defs/assignment"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "version",
        "status",
        "createdAt",
        "updatedAt",
        "updatedBy"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string"
        }
      }
    },
    "styles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 48,
      "propertyNames": {
        "enum": [
          "display",
          "position",
          "width",
          "height",
          "min-width",
          "max-width",
          "min-height",
          "max-height",
          "top",
          "right",
          "bottom",
          "left",
          "inset",
          "color",
          "background-color",
          "font-family",
          "font-size",
          "font-weight",
          "font-style",
          "line-height",
          "letter-spacing",
          "text-align",
          "text-transform",
          "white-space",
          "word-break",
          "overflow-wrap",
          "align-items",
          "align-content",
          "align-self",
          "justify-content",
          "justify-self",
          "flex-direction",
          "flex-wrap",
          "flex-grow",
          "flex-shrink",
          "flex-basis",
          "grid-template-columns",
          "grid-auto-flow",
          "gap",
          "row-gap",
          "column-gap",
          "padding",
          "padding-top",
          "padding-right",
          "padding-bottom",
          "padding-left",
          "margin",
          "margin-top",
          "margin-right",
          "margin-bottom",
          "margin-left",
          "border",
          "border-width",
          "border-style",
          "border-color",
          "border-radius",
          "box-shadow",
          "opacity",
          "overflow",
          "overflow-x",
          "overflow-y",
          "object-fit",
          "object-position",
          "aspect-ratio"
        ]
      },
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ],
        "maxLength": 180
      }
    },
    "target": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "elementId"
          ]
        },
        {
          "required": [
            "semanticRole"
          ]
        }
      ],
      "properties": {
        "elementId": {
          "type": "string",
          "maxLength": 96
        },
        "semanticRole": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "expectedTag": {
          "type": "string"
        },
        "expectedRole": {
          "type": "string"
        },
        "expectedStructureHash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "target",
        "styles"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "styles": {
          "$ref": "#/$defs/styles"
        },
        "priority": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "screenId": {
          "type": "string"
        },
        "minWidth": {
          "type": "integer",
          "minimum": 0
        },
        "maxWidth": {
          "type": "integer",
          "maximum": 7680
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "name",
            "breakpoints",
            "rules"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "maxLength": 1000
            },
            "breakpoints": {
              "type": "object",
              "maxProperties": 8,
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7680
              }
            },
            "rules": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        }
      ]
    },
    "component": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "name",
            "appliesTo",
            "styles"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "maxLength": 1000
            },
            "appliesTo": {
              "type": "object",
              "anyOf": [
                {
                  "required": [
                    "semanticRole"
                  ]
                },
                {
                  "required": [
                    "tagName"
                  ]
                }
              ],
              "properties": {
                "semanticRole": {
                  "type": "string"
                },
                "tagName": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "styles": {
              "$ref": "#/$defs/styles"
            }
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "assignment": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "screenId",
            "profiles",
            "components",
            "overrides",
            "roleBindings"
          ],
          "properties": {
            "screenId": {
              "type": "string"
            },
            "profiles": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/reference"
              }
            },
            "components": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/reference"
              }
            },
            "overrides": {
              "type": "array",
              "maxItems": 300,
              "items": {
                "type": "object",
                "required": [
                  "elementId",
                  "styles"
                ],
                "properties": {
                  "elementId": {
                    "type": "string"
                  },
                  "styles": {
                    "$ref": "#/$defs/styles"
                  }
                },
                "additionalProperties": false
              }
            },
            "roleBindings": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "required": [
                  "elementId",
                  "semanticRole"
                ],
                "properties": {
                  "elementId": {
                    "type": "string",
                    "maxLength": 96
                  },
                  "semanticRole": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  }
}
